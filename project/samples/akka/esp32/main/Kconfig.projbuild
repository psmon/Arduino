menu "AskBot device client"

    config ASKBOT_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            Akka classic remoting is TCP, so this client needs IP connectivity.
            Unlike claude_hud_amoled (BLE only by design), AskBot talks over WiFi.

    config ASKBOT_WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"

    config ASKBOT_HOST_IP
        string "AskBot.Host IP address"
        default "192.168.0.10"
        help
            Must match akka.remote.dot-netty.tcp.public-hostname on the host,
            i.e. what you pass as --host. 127.0.0.1 will not work from the board.

    config ASKBOT_HOST_PORT
        int "AskBot.Host port"
        default 2552

    config ASKBOT_HOST_SYSTEM
        string "Host ActorSystem name"
        default "AskBot"

    config ASKBOT_ACTOR_PATH
        string "Actor path to ask"
        default "/user/ask"

    config ASKBOT_LOCAL_SYSTEM
        string "This device's ActorSystem name"
        default "askbot-device"

    config ASKBOT_LOCAL_PORT
        int "Port this device advertises"
        default 2553
        help
            Advertised only. Nothing connects to it while the host keeps
            akka.remote.use-passive-connections = on (the default), which is what
            lets the device get away with having no listening socket.

endmenu
