{
  "Voice": {
    "Enabled": true,
    "ModelDir": "",
    "Voice": "F1",
    "Language": "ko",
    "Steps": 8,
    "Speed": 1.05
  },

  "Chat": {
    "Default": "echo",
    "ReplyStyle": "You are answering on a small round watch-like display. Reply in the user's language. Plain text only: no markdown, no bullet lists, no code blocks, and never include URLs, links or citations. At most 3 short sentences.",
    "MaxReplyChars": 1200,
    "ChunkBytes": 400,

    "Providers": {
      "echo": {
        "Description": "offline loopback (prompt in via stdin, echoed back) - no LLM needed",
        "Command": "powershell",
        "Args": [
          "-NoProfile", "-NonInteractive", "-Command",
          "[Console]::InputEncoding=[Text.Encoding]::UTF8; [Console]::OutputEncoding=[Text.Encoding]::UTF8; 'echo: ' + [Console]::In.ReadToEnd()"
        ],
        "PromptVia": "stdin",
        "Output": "text",
        "TimeoutSec": 20
      },
      "netclaw": {
        "Description": "netclaw chat -p (headless, JSON, named session per device)",
        "Command": "netclaw",
        "Args": [ "chat", "-p", "--json", "{session-args}" ],
        "SessionArgs": [ "--resume", "{session}" ],
        "PromptVia": "arg",
        "Output": "json",
        "ResponseField": "response",
        "TimeoutSec": 120
      },
      "claude": {
        "Description": "Claude Code CLI, prompt via stdin (claude -p --output-format json)",
        "Command": "cmd",
        "Args": [ "/c", "claude", "-p", "--output-format", "json" ],
        "PromptVia": "stdin",
        "Output": "json",
        "ResponseField": "result",
        "TimeoutSec": 180
      }
    }
  }
}
