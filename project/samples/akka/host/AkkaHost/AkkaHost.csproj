<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- WinRT (Windows.Devices.Bluetooth) for the BLE central: this host owns the watch's
         single link so that AskBot's Akka tunnel and the Chat app's line protocol can share it. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AkkaHost</RootNamespace>
    <AssemblyName>AkkaHost</AssemblyName>
    <!-- NOT invariant: with globalization-invariant mode on, String.Normalize(FormKD) leaves
         Hangul composed, every syllable maps to -1 in SuperTonic's unicode indexer (it only
         has the decomposed jamo) and Korean came out as noise. The decomposition below no
         longer depends on it, but nothing else should either. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Akka.Remote is NOT AOT-clean yet (HOCON Type loading, Props expressions,
         Newtonsoft fallback - see akkadotnet/akka.net#7246, open against the 1.6
         milestone). Keep AOT opt-in so `dotnet publish` stays usable while the
         wire protocol work happens; flip it with -p:AkkaHostAot=true to collect
         the current analyzer/runtime damage report. -->
    <PublishAot Condition="'$(AkkaHostAot)' == 'true'">true</PublishAot>
    <EnableAotAnalyzer Condition="'$(AkkaHostAot)' == 'true'">true</EnableAotAnalyzer>
    <EnableTrimAnalyzer Condition="'$(AkkaHostAot)' == 'true'">true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.6.0-beta20260912000155" />
    <PackageReference Include="Akka.Remote" Version="1.6.0-beta20260912000155" />
    <!-- SuperTonic-3 TTS runs as four ONNX graphs: no Python, no COM, no espeak-ng.
         Same runtime version AgentZeroLite pins, and the models it already
         installed under %LOCALAPPDATA%\AgentZeroLite\models\supertonic are used
         as-is - this host never downloads anything. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <!-- Offline STT: whisper.cpp through Whisper.net, CPU runtime. Uses the ggml models
         AgentZeroLite already installed under ~/.ollama/models/agentzero/whisper. -->
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <!-- GPU path, the same one AgentZeroLite uses on this machine. Whisper.net picks it when
         a Vulkan device is present and falls back to the CPU runtime otherwise. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
  </ItemGroup>

  <!-- Akka resolves its provider, transport and serializers from HOCON *by type
       name* (Type.GetType("Akka.Remote.RemoteActorRefProvider, Akka.Remote")).
       Nothing references those statically, so the trimmer drops them and the AOT
       binary dies at startup with:
         'akka.actor.provider' is not a valid type name
       Rooting the assemblies keeps the metadata that name lookup needs. This is
       the practical workaround while akka.net#7246 is open. -->
  <ItemGroup Condition="'$(AkkaHostAot)' == 'true'">
    <TrimmerRootAssembly Include="Akka" />
    <TrimmerRootAssembly Include="Akka.Remote" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="Google.Protobuf" />
    <TrimmerRootAssembly Include="DotNetty.Transport" />
    <TrimmerRootAssembly Include="DotNetty.Handlers" />
    <TrimmerRootAssembly Include="DotNetty.Codecs" />
    <TrimmerRootAssembly Include="DotNetty.Buffers" />
    <TrimmerRootAssembly Include="DotNetty.Common" />
  </ItemGroup>

</Project>
